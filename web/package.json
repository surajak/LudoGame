{
  "name": "ludo-offline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Offline, ad-free, privacy-first Ludo. Rules engine and PWA.",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:fuzz": "node --test tests/simulation.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
